# cli-proxy configuration example.
# Copy to .env and fill in real values. NEVER commit .env.
# This file must contain placeholders only.

# ---------------------------------------------------------------------------
# Proxy authentication (REQUIRED)
# ---------------------------------------------------------------------------
# Every /v1 endpoint requires this as a bearer token.
# Generate one with:  openssl rand -hex 32
CLI_PROXY_TOKEN=replace-me-with-openssl-rand-hex-32

# ---------------------------------------------------------------------------
# HTTP listener
# ---------------------------------------------------------------------------
# Keep this on loopback. Do not bind 0.0.0.0 without an authenticating proxy
# in front of it.
CLI_PROXY_HOST=127.0.0.1
CLI_PROXY_PORT=8787

# ---------------------------------------------------------------------------
# Claude Code CLI
# ---------------------------------------------------------------------------
# Absolute path to the `claude` executable. Leave blank to resolve from PATH.
# Find yours with:  which claude
CLAUDE_EXECUTABLE=/absolute/path/to/claude

# Default Claude model alias used by the `claude-cli-proxy` model id.
# One of: sonnet | opus | haiku (or a full model name).
CLAUDE_DEFAULT_MODEL=sonnet

# Hard wall-clock timeout for a single Claude CLI invocation, in seconds.
CLAUDE_TIMEOUT_SECONDS=600

# Maximum number of concurrent Claude CLI subprocesses.
CLAUDE_MAX_CONCURRENCY=1

# Working directory for the Claude subprocess. Leave blank to use a private
# empty scratch directory created at startup. Pointing this at a real project
# directory is NOT recommended.
CLAUDE_WORKING_DIR=

# ---------------------------------------------------------------------------
# Size limits
# ---------------------------------------------------------------------------
# Maximum accepted request body size, in bytes.
CLI_PROXY_MAX_REQUEST_BYTES=4194304

# Maximum accepted Claude CLI stdout size, in bytes.
CLI_PROXY_MAX_RESPONSE_BYTES=4194304

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# One of: CRITICAL | ERROR | WARNING | INFO | DEBUG
# The proxy never logs authorization headers, prompt bodies, source code,
# tool arguments or Claude output at any level.
CLI_PROXY_LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Debug dumping (DANGEROUS -- MUST BE OFF FOR NORMAL USE)
# ---------------------------------------------------------------------------
# These three switches exist for one job: finding out what an editor actually
# sends. They DISABLE the logging hygiene described above.
#
# With CLI_PROXY_DEBUG_DUMP=1 the proxy writes one JSON file per request
# containing, in cleartext: the inbound headers and body, the full prompt sent
# to the Claude CLI, the exact argv, the CLI's raw stdout and stderr, and the
# complete outgoing response or event stream. That means ANY SOURCE CODE the
# editor sent is on disk in plain text. Files are mode 0600 in a 0700
# directory, and the authorization header plus this proxy's own bearer token
# are still redacted -- nothing else is.
#
# ./scripts/run.sh turns this ON by default and prints a warning. Set it to 0
# here to override that.
#
# Delete the dumps when you are done:  rm -rf debug-dumps
CLI_PROXY_DEBUG_DUMP=0

# Where the dump files go. Blank means ./debug-dumps relative to the working
# directory. Created with mode 0700 if missing.
CLI_PROXY_DEBUG_DUMP_DIR=

# Also echo each dump to stdout. Only meaningful when dumping is on.
CLI_PROXY_DEBUG_DUMP_CONSOLE=0
